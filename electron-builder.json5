// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.wuzuan.neonwave",
  "asar": true,
  "npmRebuild": false,
  "asarUnpack": [
    "**/node_modules/yt-search/**",
    "**/node_modules/cheerio/**",
    "**/node_modules/ffmpeg-static/**"
  ],
  "productName": "NeonWave",
  // 694x694 png — electron-builder converts to ico/icns per platform
  "icon": "icon.png",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    // zip is required for electron-updater on macOS; dmg is for humans.
    // arm64 only: CI runners are Apple Silicon and native deps (opus) are
    // installed for the host arch.
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "category": "public.app-category.music",
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "include": "installer.nsh"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "AudioVideo",
    "maintainer": "wu-zuan",
    "artifactName": "${productName}-Linux-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "wu-zuan",
      "repo": "NeonWaveMusicPlayer",
      "releaseType": "release"
    }
  ]
}
